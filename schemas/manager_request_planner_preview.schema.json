{
  "$id": "https://gilmore307.github.io/trading-manager/schemas/manager_request_planner_preview.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "availability_note": {"type": "string"},
    "candidate_ref": {"type": "string"},
    "contract_type": {"const": "manager_request"},
    "deadline_at_utc": {"type": ["string", "null"]},
    "dry_run": {"type": "boolean"},
    "end_date_exclusive": {"pattern": "^\\d{4}-\\d{2}-\\d{2}$", "type": "string"},
    "evaluation_run_refs": {"items": {"type": "string"}, "type": "array"},
    "evidence_component_id": {"type": "string"},
    "evidence_refs": {"items": {"type": "string"}, "type": "array"},
    "expected_outputs": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "exposure_type": {"type": "string"},
    "feature_grain": {"type": "string"},
    "model_id": {"type": "string"},
    "model_layer": {"type": "string"},
    "model_name": {"type": "string"},
    "month": {"pattern": "^\\d{4}-\\d{2}$", "type": "string"},
    "output_contract": {"type": "string"},
    "parameter_ref": {"type": ["string", "null"]},
    "policy_refs": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "priority": {"enum": ["critical", "high", "normal", "low", "backlog"]},
    "request_id": {"minLength": 1, "type": "string"},
    "request_kind": {"minLength": 1, "type": "string"},
    "requested_by": {"minLength": 1, "type": "string"},
    "start_date": {"pattern": "^\\d{4}-\\d{2}-\\d{2}$", "type": "string"},
    "status": {"enum": ["requested", "running", "succeeded", "failed", "blocked", "cancelled", "ready", "partial", "superseded", "expired", "deleted"]},
    "symbol": {"type": "string"},
    "target_component_id": {"minLength": 1, "type": "string"},
    "target_component_kind": {"minLength": 1, "type": "string"},
    "target_repo_id": {"minLength": 1, "type": "string"},
    "timeframe": {"type": "string"},
    "universe_ref": {"type": "string"},
    "universe_type": {"type": "string"}
  },
  "required": [
    "request_id",
    "contract_type",
    "request_kind",
    "status",
    "requested_by",
    "target_component_id",
    "target_component_kind",
    "target_repo_id",
    "expected_outputs",
    "policy_refs",
    "priority",
    "dry_run"
  ],
  "title": "manager_request_planner_preview",
  "type": "object"
}
