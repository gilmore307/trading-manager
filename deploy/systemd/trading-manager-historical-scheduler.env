# Optional host override file for /etc/default/trading-manager-historical-scheduler.
# The systemd unit provides these defaults; copy this file to /etc/default only
# when the host needs an explicit reviewed override.

TRADING_MANAGER_HISTORICAL_START_MONTH=2016-01
TRADING_MANAGER_HISTORICAL_END_MONTH=2016-01
TRADING_MANAGER_HISTORICAL_INTERVAL_SECONDS=300
