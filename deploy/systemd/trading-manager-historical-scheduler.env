# Optional host override file for /etc/default/trading-manager-historical-scheduler.
# The systemd unit provides these defaults; copy this file to /etc/default only
# when the host needs an explicit reviewed override. Month values are bootstrap
# fallbacks: the service normally selects the next work item from durable
# completed/open workflow state.

TRADING_MANAGER_HISTORICAL_START_MONTH=2016-01
TRADING_MANAGER_HISTORICAL_END_MONTH=2016-06
# Leave target unpinned by default so the daemon reads
# runtime/model_training_target_queue.json and rotates Layer 3+ targets
# automatically. Add --target-symbol through a reviewed service override only
# when intentionally pinning a repair run to one target.
TRADING_MANAGER_HISTORICAL_INTERVAL_SECONDS=5
TRADING_MANAGER_PROVIDER_STAGE_NEXT_LIMIT=80
TRADING_MANAGER_PROVIDER_STAGE_MAX_WORKERS=4
TRADING_MANAGER_MONTH_INGEST_WORKERS=1
TRADING_MANAGER_DRAIN_MAX_STEPS=50
TRADING_MANAGER_DRAIN_MAX_SECONDS=300
TRADING_MANAGER_DASHBOARD_REFRESH_SERVICE_UNIT=trading-storage-dashboard-read-model-refresh.service
TRADING_MANAGER_DASHBOARD_REFRESH_ON_WORKFLOW_STATE_WRITE=true
TRADING_MANAGER_DASHBOARD_REFRESH_NO_BLOCK=true
TRADING_MANAGER_DASHBOARD_REFRESH_TRIGGER_TIMEOUT_SECONDS=5
# Pre-promotion full-training mode: no production model is active yet, so
# market-hours historical-training protection is disabled. Re-enable before
# production model activation/live trading by setting this to true.
TRADING_MANAGER_MARKET_HOURS_PROTECTION_ENABLED=false
# Server-wide error notifications: failed manager/server tasks create agent-error
# diagnosis artifacts and send a Discord alert to this reviewed channel.
MANAGER_AGENT_ERROR_NOTIFY_DISCORD=true
MANAGER_AGENT_ERROR_DISCORD_SERVER_ID=1480186849241731084
MANAGER_AGENT_ERROR_DISCORD_TARGET=channel:1504100135200620665
# Reviewed Codex CLI error repair runner. Deterministic safe repair remains
# available as an explicit narrow fallback script.
MANAGER_AGENT_ERROR_AUTOCALL=true
MANAGER_AGENT_ERROR_RUNNER_COMMAND=/root/projects/trading-manager/.venv/bin/python /root/projects/trading-manager/scripts/tasks/run_agent_error_agent.py
MANAGER_AGENT_ERROR_CODEX_MODEL=gpt-5.5
MANAGER_AGENT_ERROR_CODEX_TIMEOUT_SECONDS=1800
MANAGER_AGENT_ERROR_CODEX_SANDBOX=danger-full-access
MANAGER_AGENT_ERROR_DEDUP_SECONDS=3600
