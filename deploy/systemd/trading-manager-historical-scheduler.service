[Unit]
Description=Trading Manager Historical Modeling Scheduler
Documentation=file:/root/projects/trading-manager/docs/26_historical_scheduler_runtime.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/trading-manager
Environment=PYTHONPATH=/root/projects/trading-manager/src:/root/projects/trading-data/src:/root/projects/trading-storage/src:/root/projects/trading-model/src
Environment=TRADING_MANAGER_HISTORICAL_START_MONTH=2016-01
Environment=TRADING_MANAGER_HISTORICAL_END_MONTH=2017-06
Environment=TRADING_MANAGER_HISTORICAL_INTERVAL_SECONDS=5
Environment=TRADING_MANAGER_PROVIDER_STAGE_NEXT_LIMIT=80
Environment=TRADING_MANAGER_PROVIDER_STAGE_MAX_WORKERS=4
Environment=TRADING_MANAGER_MONTH_INGEST_WORKERS=1
Environment=TRADING_MANAGER_DRAIN_MAX_STEPS=50
Environment=TRADING_MANAGER_DRAIN_MAX_SECONDS=300
Environment=TRADING_MANAGER_DASHBOARD_REFRESH_SERVICE_UNIT=trading-storage-dashboard-read-model-refresh.service
Environment=TRADING_MANAGER_DASHBOARD_REFRESH_ON_WORKFLOW_STATE_WRITE=true
Environment=TRADING_MANAGER_DASHBOARD_REFRESH_NO_BLOCK=true
Environment=TRADING_MANAGER_DASHBOARD_REFRESH_TRIGGER_TIMEOUT_SECONDS=5
Environment=TRADING_MANAGER_MARKET_HOURS_PROTECTION_ENABLED=false
Environment=TRADING_MANAGER_SCHEDULER_PROGRESS_STALL_SECONDS=600
Environment=TRADING_MANAGER_STAGE_MAX_RSS_MB=16384
Environment=TRADING_MANAGER_STAGE_MIN_AVAILABLE_MEMORY_MB=4096
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/default/trading-manager-historical-scheduler
ExecStart=/root/projects/trading-manager/.venv/bin/python /root/projects/trading-manager/scripts/tasks/run_automation_scheduler_daemon.py \
  --start-month ${TRADING_MANAGER_HISTORICAL_START_MONTH} \
  --end-month ${TRADING_MANAGER_HISTORICAL_END_MONTH} \
  --interval-seconds ${TRADING_MANAGER_HISTORICAL_INTERVAL_SECONDS} \
  --execute-safe-preparation \
  --execute-safe-offline-stages \
  --execute-autonomous-provider-stages \
  --provider-stage-next-limit ${TRADING_MANAGER_PROVIDER_STAGE_NEXT_LIMIT} \
  --provider-stage-max-workers ${TRADING_MANAGER_PROVIDER_STAGE_MAX_WORKERS} \
  --month-ingest-workers ${TRADING_MANAGER_MONTH_INGEST_WORKERS} \
  --auto-select-next-work \
  --advance-month-on-complete \
  --drain-ready-stages \
  --drain-max-steps ${TRADING_MANAGER_DRAIN_MAX_STEPS} \
  --drain-max-seconds ${TRADING_MANAGER_DRAIN_MAX_SECONDS} \
  --refresh-dashboard-on-decision \
  --dashboard-refresh-service-unit ${TRADING_MANAGER_DASHBOARD_REFRESH_SERVICE_UNIT} \
  --progress-stall-seconds ${TRADING_MANAGER_SCHEDULER_PROGRESS_STALL_SECONDS}
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=60
MemoryHigh=20G
MemoryMax=24G
MemorySwapMax=1G
OOMPolicy=stop
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
