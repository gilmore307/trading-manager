[Unit]
Description=Trading Manager Historical Modeling Scheduler
Documentation=file:/root/projects/trading-manager/docs/99_historical_scheduler_runtime.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/trading-manager
Environment=PYTHONPATH=/root/projects/trading-manager/src
Environment=TRADING_MANAGER_HISTORICAL_START_MONTH=2016-01
Environment=TRADING_MANAGER_HISTORICAL_END_MONTH=2016-01
Environment=TRADING_MANAGER_HISTORICAL_INTERVAL_SECONDS=60
Environment=TRADING_MANAGER_PROVIDER_STAGE_NEXT_LIMIT=12
Environment=TRADING_MANAGER_PROVIDER_STAGE_MAX_WORKERS=4
Environment=TRADING_MANAGER_MARKET_HOURS_PROTECTION_ENABLED=false
EnvironmentFile=-/etc/default/trading-manager-historical-scheduler
ExecStart=/usr/bin/python3 /root/projects/trading-manager/scripts/tasks/run_automation_scheduler_daemon.py \
  --start-month ${TRADING_MANAGER_HISTORICAL_START_MONTH} \
  --end-month ${TRADING_MANAGER_HISTORICAL_END_MONTH} \
  --interval-seconds ${TRADING_MANAGER_HISTORICAL_INTERVAL_SECONDS} \
  --execute-safe-preparation \
  --execute-safe-offline-stages \
  --execute-autonomous-provider-stages \
  --provider-stage-next-limit ${TRADING_MANAGER_PROVIDER_STAGE_NEXT_LIMIT} \
  --provider-stage-max-workers ${TRADING_MANAGER_PROVIDER_STAGE_MAX_WORKERS} \
  --auto-select-next-work \
  --advance-month-on-complete
Restart=always
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
